{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sprout-adventure-rooms",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "ratelimits": [{ "name": "ROOM_CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vars": {
    "ALLOWED_ORIGINS": "https://xq3334.github.io",
    "ALLOW_LOCALHOST": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomRelay"] }],
  "env": {
    "development": {
      "ratelimits": [{ "name": "ROOM_CONNECT_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }],
      "vars": {
        "ALLOWED_ORIGINS": "https://xq3334.github.io",
        "ALLOW_LOCALHOST": "true"
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomRelay" }]
      }
    }
  }
}
